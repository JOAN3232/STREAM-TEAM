# Frontend — only this is required in React
VITE_API_URL=http://localhost:8080

# Movie Service (TMDB + VidSrc). Never put these in Vite/React.
TMDB_API_KEY=
TMDB_READ_ACCESS_KEY=
YOUTUBE_API_KEY=
VIDSRC_BASE_URL=https://vidsrcme.ru

# MongoDB Atlas (auth-service, user-service)
MONGODB_URI=

# JWT (auth-service)
JWT_SECRET=
JWT_EXPIRATION=86400000

# Resend email verification
RESEND_API_KEY=
MAIL_FROM=

# Paystack TEST mode only (never live keys)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# CORS (comma-separated, no wildcards in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional service ports
SERVER_PORT=8082
